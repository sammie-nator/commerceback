# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce

# Admin auth (no JWT — opaque session tokens stored in MongoDB)
# Used once by `node seedAdmin.js` to create the first admin login
ADMIN_NAME=Store Owner
ADMIN_USERNAME=admin
ADMIN_PIN=1234

# M-Pesa Daraja (Sandbox or Production)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=your_till_or_paybill_number
MPESA_STORE_NUMBER=your_store_number
MPESA_PASSKEY=your_lipa_na_mpesa_passkey
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline
# Must be a public HTTPS URL (use ngrok in dev) reachable by Safaricom
MPESA_CALLBACK_URL=https://your-public-url.example.com/api/mpesa/callback
